# 複製為 .env 後替換本機值。此檔僅含假值，不可放入正式憑證。
DATABASE_URL="postgresql://vowbook:replace-with-local-password@localhost:5432/vowbook?schema=public"
POSTGRES_DB="vowbook"
POSTGRES_USER="vowbook"
POSTGRES_PASSWORD="replace-with-local-password"
POSTGRES_PORT="5432"
VOWBOOK_PORT="3000"

# Google Cloud Console OAuth 2.0 Web application credentials
GOOGLE_CLIENT_ID="replace-with-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"

# 使用 openssl rand -base64 32 等安全方式為各環境建立獨立值
AUTH_SECRET="replace-with-a-long-random-secret"

# Host 上的 root-path 本機開發設定；NextAuth v4 會把 pathname 當作 auth API base path
NEXT_PUBLIC_BASE_PATH=""
NEXTAUTH_URL="http://localhost:3000/api/auth"

# Docker Compose 自架設定；部署在子路徑時，請同步調整兩個值與 OAuth redirect URI
VOWBOOK_BASE_PATH=""
VOWBOOK_NEXTAUTH_URL="http://localhost:3000/api/auth"
# 容器內固定使用 postgres:5432；密碼中的保留字元必須先做 percent-encoding
VOWBOOK_DATABASE_URL="postgresql://vowbook:replace-with-url-encoded-password@postgres:5432/vowbook?schema=public"
